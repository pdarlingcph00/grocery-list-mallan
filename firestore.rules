rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isHousehold() {
      return request.auth != null
        && request.auth.uid in [
          "PASTE_FIRST_USER_UID_HERE",
          "PASTE_SECOND_USER_UID_HERE"
        ];
    }

    match /lists/{listId} {
      allow read, write: if isHousehold();

      match /items/{itemId} {
        allow read, write: if isHousehold();
      }
    }

    match /itemHistory/{entryId} {
      allow read, write: if isHousehold();
    }
  }
}
