rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isHousehold() {
      return request.auth != null
        && request.auth.uid in [
          "Ijt4z743R0MmZIO5pQhKZRWtf3Z2",
          "91zfoGLInNTylWwgumW6Kyc95Nq1"
        ];
    }

    match /lists/{listId} {
      allow read, write: if isHousehold();

      match /items/{itemId} {
        allow read, write: if isHousehold();
      }
    }

    match /itemHistory/{entryId} {
      allow read, write: if isHousehold();
    }
  }
}
